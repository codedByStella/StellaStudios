#!/bin/bash
# ==========================================================
# ENGINE CONTROL MASTER SCRIPT — "custom_commands"
# Runs from the configured server environment.
# ==========================================================

ENGINE_ROOT="REDACTED"
PY_ROOT="REDACTED"
SCHEDULER_SERVICE="REDACTED"
UPLOADER_SERVICE="REDACTED"

DIAG_DIR="$ENGINE_ROOT/diagnostics"
OVERVIEW_LOG="$DIAG_DIR/engine_overview.log"
DETAIL_LOG="$DIAG_DIR/engine_detail.log"

# ------------------------------
# COLOR VARIABLES
# ------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ------------------------------
# HELP MENU
# ------------------------------
show_help() {
  cat <<EOF

Usage: custom_commands <command>

Available commands:
  help            - Show this help menu
  test            - Test the custom_commands script

  refresh         - Reload systemd & restart scheduler and uploader
  run             - Manually run the pipeline in DEBUG mode (cheap presets)

  auto_on         - Enable & start the scheduler (autonomous mode on)
  auto_off        - Stop (and disable) the scheduler (autonomous mode off)

  test_gpt        - Test GPT node in debug mode
  test_sora       - Show historical Sora integration status
  test_elevenlabs - Test ElevenLabs node in debug mode
  test_music      - Test Music node in debug mode

  diag            - Show engine health snapshot (services + overview log tail)
  diag_full       - Full deep-dive diagnostics (services + both logs + filesystem)

EOF
}

# ------------------------------
# TEST COMMAND
# ------------------------------
test_command() {
  echo -e "${GREEN}Custom commands are wired and responding.${RESET}"
}

# ------------------------------
# REFRESH COMMAND
# ------------------------------
refresh_command() {
  echo -e "${BOLD}${CYAN}Refreshing engine systems…${RESET}"

  echo -e "${BLUE}• Reloading systemd…${RESET}"
  sudo systemctl daemon-reload

  echo -e "${BLUE}• Restarting scheduler service (${SCHEDULER_SERVICE})…${RESET}"
  sudo systemctl restart "$SCHEDULER_SERVICE" || \
    echo -e "${YELLOW}  (scheduler restart failed or service not found)${RESET}"

  echo -e "${BLUE}• Restarting uploader service (${UPLOADER_SERVICE})…${RESET}"
  sudo systemctl restart "$UPLOADER_SERVICE" || \
    echo -e "${YELLOW}  (uploader restart failed or service not found)${RESET}"

  echo -e "${YELLOW}• Dropbox restart skipped: executable path is redacted in this showcase.${RESET}"

  echo -e "${BLUE}• Checking statuses…${RESET}"
  sudo systemctl status "$SCHEDULER_SERVICE" --no-pager | head -n 8 || true
  sudo systemctl status "$UPLOADER_SERVICE" --no-pager | head -n 8 || true

  echo -e "${GREEN}Engine refresh complete.${RESET}"
}

