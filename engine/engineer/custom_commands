# ------------------------------
# AUTONOMOUS MODE: ENABLE + START
# ------------------------------
auto_on_command() {
  echo -e "${BOLD}${CYAN}Enabling Autonomous Mode (scheduler)…${RESET}"

  sudo systemctl enable --now "$SCHEDULER_SERVICE" && \
    echo -e "${GREEN}✓ Scheduler enabled and started.${RESET}" || \
    echo -e "${RED}✗ Failed to enable/start scheduler.${RESET}"

  echo -e "${BLUE}Current scheduler status:${RESET}"
  sudo systemctl status "$SCHEDULER_SERVICE" --no-pager | head -n 12 || true
}

# ------------------------------
# AUTONOMOUS MODE: DISABLE + STOP
# ------------------------------
auto_off_command() {
  echo -e "${BOLD}${CYAN}Disabling Autonomous Mode (scheduler)…${RESET}"

  sudo systemctl stop "$SCHEDULER_SERVICE" && \
    echo -e "${GREEN}✓ Scheduler stopped.${RESET}" || \
    echo -e "${YELLOW}⚠ Failed to stop scheduler or it was not running.${RESET}"

  sudo systemctl disable "$SCHEDULER_SERVICE" && \
    echo -e "${GREEN}✓ Scheduler disabled (won't start on boot).${RESET}" || \
    echo -e "${YELLOW}⚠ Failed to disable scheduler.${RESET}"

  echo -e "${BLUE}Current scheduler status:${RESET}"
  sudo systemctl status "$SCHEDULER_SERVICE" --no-pager | head -n 12 || true
}

