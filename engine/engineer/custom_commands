# ------------------------------
# DIAGNOSTICS — SUMMARY (REFAC FINAL)
# ------------------------------
diag_command() {
  echo -e "${BOLD}${CYAN}================ ENGINE DIAGNOSTIC SNAPSHOT ================${RESET}"

  # ---------------------------------------
  # SERVICE STATUS
  # ---------------------------------------
  echo -e "${BOLD}${BLUE}--- Service Status ---${RESET}"

  get_status() {
    local svc="$1"
    local raw
    raw=$(systemctl is-active "$svc" 2>/dev/null)

    case "$raw" in
      active)       echo -e "${GREEN}active${RESET}" ;;
      inactive)     echo -e "${YELLOW}inactive${RESET}" ;;
      activating)   echo -e "${YELLOW}activating${RESET}" ;;
      failed)       echo -e "${RED}failed${RESET}" ;;
      deactivating) echo -e "${YELLOW}deactivating${RESET}" ;;
      *)            echo -e "${YELLOW}unknown${RESET}" ;;
    esac
  }

  echo -e "Scheduler: $(get_status "$SCHEDULER_SERVICE")"
  echo -e "Uploader:  $(get_status "$UPLOADER_SERVICE")"

  # ---------------------------------------
  # NODE STATUS
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Node Status (from overview log) ---${RESET}"

  node_status() {
    local label="$1"
    local pattern="$2"

    if [ ! -f "$OVERVIEW_LOG" ]; then
      echo -e "$label: ${YELLOW}no log${RESET}"
      return
    fi

    local last
    last=$(grep "$pattern" "$OVERVIEW_LOG" | tail -n 1)

    if [ -z "$last" ]; then
      echo -e "$label: ${YELLOW}IDLE${RESET}"
      return
    fi

    if echo "$last" | grep -qiE "ERROR|FAILED"; then
      echo -e "$label: ${RED}✗ FAIL${RESET} (details redacted)"
    else
      echo -e "$label: ${GREEN}✓ PASS${RESET}"
    fi
  }

  node_status "GPT"        "\[GPT\]"
  node_status "MUSIC"      "\[MUSIC\]"
  node_status "ELEVENLABS" "\[ELEVENLABS\]"
  node_status "SORA"       "\[SORA\]"
  node_status "STITCHER"   "STITCHER"
  node_status "UPLOADER"   "Uploader"

  # ---------------------------------------
  # LATEST SLUG
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Latest Slug ---${RESET}"

  # REDACTED — production pending/processed directory paths.
  # REDACTED — media filenames and slugs are not exposed.

  # ---------------------------------------
  # DIRECTORY INTEGRITY
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Directory Integrity ---${RESET}"

  check_dir() {
    local d="$1"
    if [ -d "$d" ]; then
      local count
      count=$(ls -1 "$d" | wc -l)
      echo -e "${GREEN}✓${RESET} [REDACTED — production directory] (${count} items)"
      if [ "$count" -eq 0 ]; then
        echo "    (empty)"
      else
        # REDACTED — directory entries may expose media names and operational data.
        :
      fi
    else
      echo -e "${RED}✗ Missing:${RESET} [REDACTED — production directory]"
    fi
  }

  # REDACTED — production directory paths.
  # Original checks covered metadata, video, voiceover, music, and merged-media queues.

  # ---------------------------------------
  # OVERVIEW LOG (color coded)
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Overview Log (last 20) ---${RESET}"

  if [ -f "$OVERVIEW_LOG" ]; then
    tail -n 20 "$OVERVIEW_LOG" | while IFS= read -r line; do
      if echo "$line" | grep -qiE "ERROR|FAILED"; then
        echo -e "${RED}[REDACTED — error log entry]${RESET}"
      elif echo "$line" | grep -qiE "OK|Success|completed|complete"; then
        echo -e "${GREEN}[REDACTED — success log entry]${RESET}"
      elif echo "$line" | grep -qi "start"; then
        echo -e "${YELLOW}[REDACTED — startup log entry]${RESET}"
      else
        echo "[REDACTED — log entry]"
      fi
    done
  else
    echo -e "${YELLOW}(overview log missing)${RESET}"
  fi

  echo -e "${BOLD}${CYAN}==================== END OF SNAPSHOT =======================${RESET}"
}

# ------------------------------
# DIAGNOSTICS — FULL (REFAC FINAL)
# ------------------------------
diag_full_command() {
  echo -e "${BOLD}${CYAN}================ FULL ENGINE DIAGNOSTIC DUMP ================${RESET}"

  # ---------------------------------------
  # SERVICE STATUS
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Scheduler Service ---${RESET}"
  if systemctl status "$SCHEDULER_SERVICE" --no-pager >/dev/null 2>&1; then
    systemctl status "$SCHEDULER_SERVICE" --no-pager
  else
    echo -e "${YELLOW}(service not found)${RESET}"
  fi

  echo -e "\n${BOLD}${BLUE}--- Uploader Service ---${RESET}"
  if systemctl status "$UPLOADER_SERVICE" --no-pager >/dev/null 2>&1; then
    systemctl status "$UPLOADER_SERVICE" --no-pager
  else
    echo -e "${YELLOW}(service not found)${RESET}"
  fi

  # ---------------------------------------
  # JOURNAL LOGS
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Scheduler Journal (last 40) ---${RESET}"
  journalctl -u "$SCHEDULER_SERVICE" -n 40 --no-pager || \
  echo -e "${YELLOW}(no journal entries)${RESET}"

  echo -e "\n${BOLD}${BLUE}--- Uploader Journal (last 40) ---${RESET}"
  journalctl -u "$UPLOADER_SERVICE" -n 40 --no-pager || \
  echo -e "${YELLOW}(no journal entries)${RESET}"

  # ---------------------------------------
  # OVERVIEW LOG
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Overview Log (last 50) ---${RESET}"
  if [ -f "$OVERVIEW_LOG" ]; then
    tail -n 50 "$OVERVIEW_LOG" | while IFS= read -r line; do
      if echo "$line" | grep -qiE "ERROR|FAILED"; then
        echo -e "${RED}[REDACTED — error log entry]${RESET}"
      elif echo "$line" | grep -qiE "OK|Success|completed|complete"; then
        echo -e "${GREEN}[REDACTED — success log entry]${RESET}"
      elif echo "$line" | grep -qi "start"; then
        echo -e "${YELLOW}[REDACTED — startup log entry]${RESET}"
      else
        echo "[REDACTED — log entry]"
      fi
    done
  else
    echo -e "${YELLOW}(overview log missing)${RESET}"
  fi

  # ---------------------------------------
  # DETAIL LOG
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Detail Log (last 50) ---${RESET}"
  if [ -f "$DETAIL_LOG" ]; then
    tail -n 50 "$DETAIL_LOG" | while IFS= read -r line; do
      if echo "$line" | grep -qiE "ERROR|FAILED"; then
        echo -e "${RED}[REDACTED — error log entry]${RESET}"
      else
        echo "[REDACTED — log entry]"
      fi
    done
  else
    echo -e "${YELLOW}(detail log missing)${RESET}"
  fi

  # ---------------------------------------
  # FULL FILESYSTEM SNAPSHOT
  # ---------------------------------------
  echo -e "\n${BOLD}${BLUE}--- Dropbox Engine Structure ---${RESET}"

  # REDACTED — original recursive listing exposed production directory
  # structure and filenames.

  echo -e "${BOLD}${CYAN}================ END OF FULL DIAGNOSTICS ===================${RESET}"
}

# ------------------------------
# COMMAND PARSER
# ------------------------------
case "$1" in
  help|"")      show_help ;;
  test)         test_command ;;
  refresh)      refresh_command ;;
  run)          run_pipeline_command ;;
  run_auto)     run_pipeline_auto_command ;;
  auto_on)      auto_on_command ;;
  auto_off)     auto_off_command ;;
  test_gpt)     test_gpt_command ;;
  test_sora)    test_sora_command ;;
  test_elevenlabs) test_elevenlabs_command ;;
  test_music)   test_music_command ;;
  diag)         diag_command ;;
  diag_full)    diag_full_command ;;
  *)
    echo -e "${RED}Unknown command:${RESET} $1"
    echo "Use: custom_commands help"
    ;;
esac
